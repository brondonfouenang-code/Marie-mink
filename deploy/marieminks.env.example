/* Fichier de configuration du serveur Marie Minks.
 *
 * Ce fichier est lu par systemd au demarrage du service. Les permissions
 * doivent rester restreintes car il peut contenir ADMIN_PASSWORD :
 *   chmod 600 /etc/marieminks/marieminks.env
 *
 * Ne pas versionner ce fichier : il n'est pas destine a etre partage.
 */

/* Interface d'ecoute.
 *
 * 127.0.0.1 signifie "uniquement cette machine". C'est le bon choix si un
 * reverse proxy (Nginx, Caddy) separe l'exterieur du service : le serveur
 * ne repond alors jamais directement sur Internet.
 *
 * 0.0.0.0 ouvre le port a toutes les interfaces. A n'utiliser que si aucun
 * reverse proxy n'est mis en place.
 */
HOST=127.0.0.1

/* Port interne du service. Inchange, car le reverse proxy pointe dessus. */
PORT=8000

/* Nom de domaine public, sans point final.
 *
 * Cette valeur est critique : elle construit les URLs canoniques, le
 * sitemap et les balises Open Graph. Si elle reste sur la valeur par defaut,
 * Google indexera des adresses en 127.0.0.1 et le site ne sera pas trouvable.
 *
 * Exemples : marieminks.co.uk  —  www.marieminks.co.uk
 */
SITE_URL=https://marieminks.co.uk

/* Mot de passe du premier administrateur.
 *
 * A UTILISER UNE SEULE FOIS, pour la creation initiale du compte.
 *
 * Attention : cette variable impose son mot de passe a CHAQUE demarrage du
 * serveur. Si elle reste en place, un changement de mot de passe fait depuis
 * l'admin sera efface au prochain redemarrage. Le script d'installation la
 * retire donc automatiquement apres la premiere creation du compte.
 *
 * Laissez-la vide une fois le compte cree.
 */
ADMIN_PASSWORD=