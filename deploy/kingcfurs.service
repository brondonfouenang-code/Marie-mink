# Service systemd pour le site Marie Minks.
#
# A installer dans /etc/systemd/system/kingcfurs.service
#   sudo cp deploy/kingcfurs.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now kingcfurs
#
# Commandes utiles :
#   sudo systemctl status kingcfurs      voir l'etat
#   sudo systemctl restart kingcfurs     redemarrer apres un changement
#   sudo journalctl -u kingcfurs -f      voir les journaux en direct
#   sudo journalctl -u kingcfurs --since today
#
# Pour voir le mot de passe du premier compte, au demarrage uniquement :
#   sudo journalctl -u kingcfurs -n 30 --no-pager

[Unit]
Description=Site Marie Minks
Documentation=https://kingcfurs.co.uk
# Le service demarre apres le reseau : sans cela, Node peut ne pas
#voir les interfaces au moment du demarrage sur un VPS lent.
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

# --- Utilisateur dedie -----------------------------------------------------
# Le service ne tourne PAS en root. C'est la premiere des precautions :
# une faille dans le site ne donne pas les privileges administrateur.
User=kingcfurs
Group=kingcfurs

WorkingDirectory=/srv/kingcfurs

# --- Configuration ---------------------------------------------------------
EnvironmentFile=/etc/kingcfurs/kingcfurs.env

# --- Demarrage -------------------------------------------------------------
# --reset-password ne doit PAS etre ici : ce drapeau affiche un mot de
# passe et termine le processus, ce qui ferait tomber le service.
ExecStart=/usr/bin/node /srv/kingcfurs/server.js

# --- Redemarrage automatique ------------------------------------------------
Restart=always
RestartSec=5
# Si le serveur plante en boucle, on arrete d'insister plutot que de
# saturer la machine et les journaux.
StartLimitBurst=5
StartLimitIntervalSec=60

# --- Journalisation --------------------------------------------------------
StandardOutput=journal
StandardError=journal
SyslogIdentifier=kingcfurs

# --- Durcissement ----------------------------------------------------------
# Le processus n'a besoin que de lire ses fichiers et d'ecrire dans data/.
# Tout le reste lui est refuse par le noyau, pas par le code.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
# Seule exception : data/ doit rester inscriptible.
ReadWritePaths=/srv/kingcfurs/data
LockPersonality=true
MemoryDenyWriteExecute=true

# --- Limites ---------------------------------------------------------------
# Une boutique ne devrait jamais depasser 300 Mo. Cette limite protege le
# VPS si une requete manipule erroneusement une image.
MemoryMax=300M
# Au-dela, le service est tue puis relance : evite de rester en erreur.
MemorySwapMax=512M

[Install]
WantedBy=multi-user.target